# انسخه إلى .env للتطوير المحلي.
# كل متغيّر هنا يفشل بصمت إذا أُغفل: النظام يقلع، وصفحة الدخول تظهر، ولا أحد يدخل.

# قاعدة SQLite. محلياً ملف داخل المستودع؛ على الخادم ملف على القرص المُثبَّت.
DATABASE_URL="file:./dev.db"

# مفتاح توقيع الجلسات — openssl rand -base64 32
AUTH_SECRET=""

# المرفقات. اتركه فارغاً محلياً؛ على الخادم وجّهه إلى القرص المُثبَّت.
# UPLOADS_DIR="/data/uploads"

# حساب المدير الأول. يُقرآن مرة واحدة عند أول إقلاع، ثم يُحذفان من إعدادات الخدمة.
# ADMIN_EMAIL="admin@flexksa.co"
# ADMIN_PASSWORD=""
